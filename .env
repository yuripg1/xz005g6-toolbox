# XZ005-G6 Toolbox — Environment Configuration
#
# Defaults tested with Vivo Brazil (Region 2, Huawei OLT).
# Adjust for other ISPs or regions. See README.md for guidance.

# ---- Device Identity (affects sys command encryption) ----
X_TP_PRODUCT_ID=477720065
BASE_KEY=478DE3F90BA5D2CF

# ---- Network (during direct-connect flash stage) ----
DEVICE_IP=192.168.1.1
HOST_IP=192.168.1.2
TFTP_PORT=6969

# ---- OMCI_CUSTOM_BDP value ----
BDP_VALUE=136

# ---- Extra flash commands injected into boot script ----
# Chain with && (semicolons blocked by firmware).
# Leave empty for default. Community-tested values:
# https://github.com/Anime4000/RTL960x
EXTRA_FLASH_COMMANDS=

# ---- Git pin for sta-c0000/tpconf_bin_xml ----
TPCONF_COMMIT=65463c4f3e745eead24d8dff41c35a76927f56bb

